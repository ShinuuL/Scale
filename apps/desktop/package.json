{
  "name": "scale-desktop",
  "productName": "Scale",
  "version": "0.1.0",
  "private": true,
  "description": "Cliente desktop (Electron) do Scale: abre o servidor Scale configurado numa janela endurecida.",
  "author": "Mastersys",
  "main": "dist/main/main.js",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "npm run typecheck && node scripts/build.mjs",
    "dev": "node scripts/build.mjs && electron . --dev --server=http://localhost:8090",
    "start": "electron .",
    "dist": "npm run build && electron-builder --win nsis --x64 --publish never",
    "lint": "eslint src/ scripts/",
    "test": "vitest run"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.0.0",
    "electron": "44.7.0",
    "electron-builder": "26.17.0",
    "esbuild": "0.28.2",
    "eslint": "^9.0.0",
    "globals": "^15.15.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.70.0",
    "vitest": "^2.0.0",
    "zod": "^3.23.0"
  },
  "engines": {
    "node": ">=20"
  }
}
