generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum RoomStatus {
  ACTIVE
  ENDED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  // Foto de perfil: caminho relativo em uploads/avatars (null = sem foto).
  avatarPath      String?
  avatarMime      String?
  avatarUpdatedAt DateTime?

  // Gate de partilha de tela (spec docs/superpowers/specs/2026-11-11-moderacao-assistente-design.md).
  // birthDate NUNCA sai em DTO publico: so o booleano isAdult.
  birthDate                 DateTime?
  ageVerifiedAt             DateTime?
  screenShareConsentAt      DateTime?
  screenShareConsentVersion String?
  ownedCommunities Community[]
  communityMemberships CommunityMember[]
  communityInvites CommunityInvite[]

  ownedRooms  Room[]
  moderationEvents ModerationEvent[]
  roomMembers RoomMember[]
  channelReadStates ChannelReadState[]
  messageReactions ChatMessageReaction[]

  username               Username?
  githubAccount          GithubAccount?
  googleAccount          GoogleAccount?
  adminGrant             AdminGrant?
  friendRequestsSent     Friendship[]    @relation("FriendshipRequester")
  friendRequestsReceived Friendship[]    @relation("FriendshipAddressee")
  directMessagesSent     DirectMessage[] @relation("DirectMessageSender")
  directMessagesReceived DirectMessage[] @relation("DirectMessageRecipient")
}

// Conta GitHub vinculada (login OAuth). Tabela propria pelo mesmo motivo do
// Username (`db push` nao adiciona unique em tabela existente). O access token
// do GitHub NAO e guardado: so serve para ler a identidade no callback.
model GithubAccount {
  id        String   @id @default(cuid())
  githubId  String   @unique
  login     String
  userId    String   @unique
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Conta Google vinculada (login OAuth/OIDC). `googleId` e o `sub` estavel do
// Google. Tabela propria pelo mesmo motivo do GithubAccount; o access token
// nao e guardado.
model GoogleAccount {
  id        String   @id @default(cuid())
  googleId  String   @unique
  userId    String   @unique
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// @nome de usuario unico (minusculo, [a-z0-9_]). Tabela propria em vez de
// coluna `@unique` em User: o `prisma db push` do container recusa adicionar
// unique em tabela existente sem --accept-data-loss; tabela nova nao tem esse
// problema. Sem linha = o usuario ainda nao escolheu.
model Username {
  name      String   @id
  userId    String   @unique
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

// Uma linha por par: quem pediu (requester) e quem recebeu (addressee). O par
// inverso nunca coexiste — o pedido cruzado vira aceite (routes/social.ts).
model Friendship {
  id          String           @id @default(uuid())
  requesterId String
  addresseeId String
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  acceptedAt  DateTime?

  requester User @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
}

// Mensagem privada entre amigos. So texto por enquanto; anexos entram depois
// numa tabela propria (como ChatFile), sem mudar esta.
model DirectMessage {
  id          String   @id @default(uuid())
  senderId    String
  recipientId String
  content     String
  createdAt   DateTime @default(now())

  sender    User @relation("DirectMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("DirectMessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([senderId, recipientId, createdAt])
  @@index([recipientId, senderId, createdAt])
}

enum CommunityRole {
  OWNER
  ADMIN
  MEMBER
}

model Community {
  id        String   @id @default(uuid())
  name      String
  ownerId   String
  createdAt DateTime @default(now())
  /// Icone e banner (uploads/community-media). Colunas novas anulaveis: db push aplica sem perda.
  iconPath        String?
  iconMime        String?
  iconUpdatedAt   DateTime?
  bannerPath      String?
  bannerMime      String?
  bannerUpdatedAt DateTime?
  /// Boas-vindas (Fase 3): canal de texto e modelo com {nome}. Anulaveis: db push sem perda.
  welcomeChannelId String?
  welcomeMessage   String?

  owner   User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members     CommunityMember[]
  categories  CommunityCategory[]
  invites     CommunityInvite[]
  rooms       Room[]
  customRoles CommunityCustomRole[]
  bans        CommunityBan[]
  auditLogs   CommunityAuditLog[]
  events      CommunityEvent[]
}

/// Categoria de canais (opcional por canal). Tabela nova: db push cria sem perda.
model CommunityCategory {
  id          String   @id @default(uuid())
  communityId String
  name        String
  position    Int      @default(0)
  createdAt   DateTime @default(now())

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  rooms     Room[]

  @@index([communityId])
}

/// Cargo personalizado (nome, cor, permissoes). Soma-se ao cargo base; nunca tira poder.
model CommunityCustomRole {
  id             String   @id @default(uuid())
  communityId    String
  name           String
  color          String
  manageChannels Boolean  @default(false)
  manageInvites  Boolean  @default(false)
  manageMessages Boolean  @default(false)
  kickMembers    Boolean  @default(false)
  createdAt      DateTime @default(now())

  community Community         @relation(fields: [communityId], references: [id], onDelete: Cascade)
  members   CommunityMember[]

  @@index([communityId])
}

model CommunityMember {
  id          String        @id @default(uuid())
  communityId String
  userId      String
  role        CommunityRole @default(MEMBER)
  joinedAt    DateTime      @default(now())
  /// Cargo personalizado (opcional). Coluna nova anulavel: db push aplica sem perda.
  customRoleId String?
  /// Castigo (Fase 3): ate quando nao envia, nao reage e nao entra na voz. Colunas anulaveis.
  timeoutUntil  DateTime?
  timeoutReason String?
  /// Apelido na comunidade (Fase 4), 1..32. Coluna anulavel: db push aplica sem perda.
  nickname      String?

  customRole CommunityCustomRole? @relation(fields: [customRoleId], references: [id], onDelete: SetNull)

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId])
  @@index([userId])
}

model CommunityInvite {
  id          String    @id @default(uuid())
  communityId String
  codeHash    String    @unique
  createdById String
  expiresAt   DateTime
  maxUses     Int?
  uses        Int       @default(0)
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  createdBy User      @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([communityId])
}

model Room {
  id               String    @id @default(uuid())
  name             String
  ownerId          String?
  isPersistent     Boolean   @default(false)
  isPrivate        Boolean   @default(false)
  maxParticipants  Int       @default(8)
  inviteToken      String    @unique @default(uuid())
  passwordHash     String?
  status           RoomStatus @default(ACTIVE)
  createdAt        DateTime  @default(now())
  expiresAt        DateTime?
  communityId      String?
  channelKind      String?
  position         Int       @default(0)
  /// Categoria do canal (anulavel; apagar a categoria solta o canal).
  categoryId       String?
  /// Topico do canal de texto (ate 200; anulavel).
  topic            String?
  /// Fase 3: canal de avisos (so quem gerencia posta; os demais leem e reagem).
  announcement     Boolean   @default(false)
  /// Fase 3: modo lento em segundos (0 = desligado; ate 6 h).
  slowModeSeconds  Int       @default(0)
  /// Limite de pessoas do canal de voz (Fase 3, 2..8; null = teto do mesh).
  userLimit        Int?

  community     Community?    @relation(fields: [communityId], references: [id], onDelete: Cascade)
  category      CommunityCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  owner         User?         @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  roomMembers   RoomMember[]
  readStates    ChannelReadState[]
  chatMessages  ChatMessage[]
  chatFiles     ChatFile[]
  permissionOverrides ChannelPermissionOverride[]
  threads       ChannelThread[]

  @@index([communityId])
  @@index([isPersistent, status])
  @@index([expiresAt])
}

model ChatMessage {
  id          String    @id @default(uuid())
  roomId      String
  authorId    String?
  guestName   String?
  /// Autoria de convidado: UUID emitido pelo servidor (cookie assinado). Null = usuario logado ou mensagem anterior ao guestId.
  guestId     String?
  content     String
  prevContent String?
  editedAt    DateTime?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  /// Resposta (Fase 2, canais de comunidade): id da mensagem citada. Sem FK: a citada pode sumir.
  replyToId   String?
  /// Fixada no canal (Fase 2). Colunas anulaveis: db push aplica sem perda.
  pinnedAt    DateTime?
  pinnedById  String?
  /// Mensagem de sistema (Fase 3, boas-vindas): sem autor, ninguem edita.
  isSystem    Boolean   @default(false)
  /// Topico (Fase 4): mensagem dentro de um ChannelThread; null = canal principal. Sem FK (coluna anulavel).
  threadId    String?

  room      Room                  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  files     ChatFile[]
  reactions ChatMessageReaction[]

  @@index([roomId, createdAt])
  @@index([roomId, deletedAt])
  @@index([authorId])
  @@index([threadId, createdAt])
}

/// Topico (Fase 4): conversa aberta a partir de uma mensagem de canal de texto.
/// Mesmas permissoes do canal pai; arquivado nao aceita envio.
model ChannelThread {
  id            String    @id @default(uuid())
  roomId        String
  rootMessageId String    @unique
  name          String
  createdById   String
  archivedAt    DateTime?
  archivedById  String?
  createdAt     DateTime  @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
}

/// Reacao (Fase 2): conjunto fixo de icones; um usuario reage uma vez por tipo.
model ChatMessageReaction {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  reaction  String
  createdAt DateTime @default(now())

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, reaction])
  @@index([messageId])
}

model ChatFile {
  id          String    @id @default(uuid())
  roomId      String
  messageId   String
  filename    String
  mime        String
  size        Int
  path        String
  uploadedBy  String?
  /// guestId do convidado que enviou (null para usuario logado).
  guestId     String?
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  room    Room        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@index([messageId])
  @@index([roomId, deletedAt])
}

model RoomMember {
  id       String @id @default(cuid())
  roomId   String
  userId   String?
  guestName String?
  joinedAt DateTime @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([roomId, userId])
}

// Evento de moderacao (texto, amostra de tela ou denuncia). Retencao:
// MODERATION_RETENTION_DAYS (default 90) pelo sweep. `excerpt` e SEMPRE null
// para frames (o quadro nunca persiste) e truncado a 120 chars para texto.
model ModerationEvent {
  id         String   @id @default(uuid())
  kind       String // 'text' | 'frame' | 'report'
  source     String // 'chat' | 'dm' | 'screen' | 'user'
  roomId     String?
  userId     String?
  guestId    String?
  reporterId String?
  category   String
  severity   String
  action     String // 'blocked' | 'warned' | 'stopped-share' | 'reported' | 'none'
  excerpt    String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt])
  @@index([userId, createdAt])
}

// Overrides da moderacao gravados pelo admin do sistema (singleton 'default').
// `null` em cada campo = usa o valor do .env. `apiKeyCiphertext`: AES-256-GCM
// com chave derivada do JWT_SECRET (lib/settingsCrypto.ts); nunca sai em DTO
// nem em log. Spec: docs/superpowers/specs/2026-11-11-admin-moderacao-design.md
model ModerationSettings {
  id                  String   @id @default("default")
  provider            String?
  model               String?
  screenEnabled       Boolean?
  frameIntervalSec    Int?
  retentionDays       Int?
  minAge              Int?
  privacyContactEmail String?
  apiKeyCiphertext    String?
  updatedById         String?
  updatedAt           DateTime @updatedAt
}

// Auditoria das alteracoes do painel de moderacao. `changes` e JSON
// `{ campo: { from, to } }`; a chave de API aparece so como 'set' | 'cleared'.
model ModerationAuditLog {
  id        String   @id @default(uuid())
  adminId   String
  adminName String
  changes   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Admin concedido pela UI (spec docs/superpowers/specs/2026-11-11-admin-usuarios-design.md).
// Admin raiz (ADMIN_EMAILS) NAO tem linha aqui: vem do .env.
model AdminGrant {
  userId      String   @id
  grantedById String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Auditoria de concessao/remocao de admin. Nomes copiados no momento do ato
// (sobrevive a renomeacao/remocao da conta).
model AdminRoleAudit {
  id         String   @id @default(uuid())
  actorId    String
  actorName  String
  targetId   String
  targetName String
  action     String // 'grant' | 'revoke'
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

/// Ultima leitura de um canal de texto de comunidade por usuario (mensagens nao lidas).
/// Tabela nova: o @@unique composto entra sem perda no `prisma db push`.
model ChannelReadState {
  id         String   @id @default(uuid())
  userId     String
  channelId  String
  lastReadAt DateTime

  user    User @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel Room @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([userId, channelId])
  @@index([channelId])
}

/// Fase 3: sobrescrita de permissao por canal. target = 'everyone' (todos os
/// membros) ou o id de um cargo personalizado. null = herda.
model ChannelPermissionOverride {
  id           String   @id @default(uuid())
  roomId       String
  target       String
  viewChannel  Boolean?
  sendMessages Boolean?
  updatedAt    DateTime @updatedAt

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, target])
}

/// Banimento (Fase 3): impede reentrar por convite. Tabela nova: db push cria sem perda.
model CommunityBan {
  id          String   @id @default(uuid())
  communityId String
  userId      String
  userName    String
  bannedById  String
  reason      String?
  createdAt   DateTime @default(now())

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId])
}

/// Registro de auditoria (Fase 3): acoes administrativas. Nomes sao copia do momento.
model CommunityAuditLog {
  id          String   @id @default(uuid())
  communityId String
  actorId     String
  actorName   String
  action      String
  targetId    String?
  targetName  String?
  reason      String?
  detail      String?
  createdAt   DateTime @default(now())

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@index([communityId, createdAt])
}

/// Evento agendado (Fase 4). Tabela nova: db push cria sem perda. Criador e
/// canal sem relacao (nao mexe em User/Room): canal apagado vira "sem canal".
model CommunityEvent {
  id          String    @id @default(uuid())
  communityId String
  creatorId   String
  creatorName String
  title       String
  description String?
  startsAt    DateTime
  endsAt      DateTime?
  channelId   String?
  createdAt   DateTime  @default(now())

  community Community               @relation(fields: [communityId], references: [id], onDelete: Cascade)
  interests CommunityEventInterest[]

  @@index([communityId, startsAt])
}

/// "Tenho interesse" (Fase 4): um por usuario e evento.
model CommunityEventInterest {
  eventId   String
  userId    String
  createdAt DateTime @default(now())

  event CommunityEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
}
