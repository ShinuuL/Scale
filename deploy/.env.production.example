# Scale — .env de PRODUCAO (VPS). Copie para a RAIZ do projeto como `.env`:
#   cp deploy/.env.production.example .env && chmod 600 .env
# NUNCA versione o .env real. Gere segredos com:
#   openssl rand -hex 32

# Dominio publico (DNS tipo A apontando para o IP da VPS).
SCALE_DOMAIN=scale.seudominio.com.br

# Porta HTTPS publica (80/443 da VPS pertencem a outro projeto).
EDGE_PORT=8443

# Certificado via DNS-01 delegado ao acme-dns. Registre uma conta com
#   curl -s -X POST https://auth.acme-dns.io/register
# e crie no DNS: _acme-challenge.<SCALE_DOMAIN> CNAME <fulldomain retornado>
ACMEDNS_SERVER_URL=https://auth.acme-dns.io
ACMEDNS_USERNAME=
ACMEDNS_PASSWORD=
ACMEDNS_SUBDOMAIN=

# Segredos (obrigatorios, >= 32 caracteres, unicos por instalacao).
JWT_SECRET=
GUEST_COOKIE_SECRET=

# Origem publica do app (CORS HTTP + Socket.io): dominio + porta.
ALLOWED_ORIGINS=https://scale.seudominio.com.br:8443

# Portas so no loopback da VPS (diagnostico via SSH).
BACKEND_PORT=4100
PROXY_PORT=8080

# O compose sobrepoe PORT, DATABASE_URL, NODE_ENV e TRUST_PROXY.
NODE_ENV=production
TRUST_PROXY=false

ENABLE_TURN=false
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Admins (CSV de e-mails): painel /metrics e exclusao de qualquer sala.
ADMIN_EMAILS=

# ---------------------------------------------------------------
# Login com GitHub (opcional). Sem os tres valores o botao some.
# Crie um OAuth App em https://github.com/settings/developers
#   Homepage URL:               <PUBLIC_URL>
#   Authorization callback URL: <PUBLIC_URL>/api/auth/github/callback
# PUBLIC_URL = origem publica do app, sem barra final.
# O client secret e SEGREDO: so no .env, nunca no Git.
# ---------------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
PUBLIC_URL=https://scale.seudominio.com.br:8443
