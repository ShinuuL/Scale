# Caddyfile — roteador INTERNO do Scale (HTTP puro, sem TLS)
#
# Este Caddy NAO termina TLS e NAO esta preso a nenhuma interface privada. Ele
# fica ATRAS do tunel: recebe HTTP em :8080, SERVE o frontend estatico (export
# do Next, copiado para /srv na imagem — ver apps/web/Dockerfile) e encaminha
# `/api/*` e `/socket.io/*` ao backend. Quem termina o TLS e o cloudflared (ver
# docker-compose.yml, profile `tunnel` e docs/tunnel-setup.md).
#
# Nao existe mais servidor Next: o browser fala com UM origin e o roteamento por
# path acontece aqui. /socket.io e /api precisam chegar ao backend COM O PREFIXO
# INTACTO.
#
# Cuidado com `handle_path`: ele REMOVE o prefixo casado antes do reverse_proxy.
# Com `handle_path /socket.io/*` o backend recebe `/?EIO=4&transport=polling` e
# responde 404 ("Route GET:/?EIO=4&transport=polling not found"). O correto aqui
# e `handle`, que casa o path mas preserva a URI original.
#
# O Host original NAO e reescrito: o cliente fala same-origin com o tunel e o
# backend usa isso para CORS/rate-limit (ver TRUST_PROXY no docker-compose.yml).
#
# IP REAL DO CLIENTE (client IP parsing):
# sem o bloco global abaixo, o Caddy IGNORA o X-Forwarded-For que recebe e o
# SUBSTITUI pelo IP do peer imediato — que, atras do tunel, e o container do
# cloudflared (172.28.0.5, privado). Resultado: TODO o trafego do tunel cai na
# MESMA chave de rate limit (ex.: 5 cadastros/hora para o mundo inteiro). A doc
# do reverse_proxy e explicita: configure `servers > trusted_proxies` para que o
# Caddy ANEXE o IP real em vez de descarta-lo, e o faca no bloco global para
# valer em todos os proxy handlers do servidor.
#
# Confiamos APENAS no cloudflared (172.28.0.5/32): e o unico peer legitimo a
# frente do Caddy. NAO incluir a subnet inteira (172.28.0.0/16) nem o gateway
# (172.28.0.1) — confiar neles permitiria a qualquer host da rede forjar o
# X-Forwarded-For e furar os baldes por IP.
#
# Na VPS tambem confiamos na borda (172.28.0.6, porta 8443) e no Caddy do
# Nexus (172.28.0.7), que atende o endereco sem porta nas 80/443 e entra na
# rede do Scale com esse IP fixo (ver docs/vps-deploy.md).
{
	servers {
		trusted_proxies static 172.28.0.5/32 172.28.0.6/32 172.28.0.7/32
	}
}

:8080 {
	# API REST e signaling -> backend, preservando o path (handle, nao handle_path).
	# O Caddy e o UNICO hop entre o browser/tunel e o backend: o backend confia
	# apenas nele (172.28.0.4) e no cloudflared (172.28.0.5) em TRUST_PROXY.
	handle /api/* {
		reverse_proxy backend:4000
	}
	handle /socket.io/* {
		reverse_proxy backend:4000
	}

	# Compatibilidade: links antigos /room/<id>[?token=...] -> /room?id=<id>[&token=...].
	# O export estatico nao tem rota dinamica. Com query string ela e anexada com
	# `&`; sem query, nao sobra `&` no fim. O id so aceita [0-9A-Za-z-].
	@oldroom path_regexp oldroom ^/room/([0-9A-Za-z-]{1,64})/?$
	handle @oldroom {
		@withquery expression {query} != ""
		redir @withquery /room?id={re.oldroom.1}&{query} 302
		redir * /room?id={re.oldroom.1} 302
	}

	# Deploy com aba aberta: o build antigo busca o payload RSC (/x.txt?_rsc=...)
	# do build novo, o buildId nao bate e o Next navega o NAVEGADOR para o .txt.
	# Navegacao de documento para um .txt com _rsc volta para a pagina (com a query,
	# ex.: /room.txt?id=..&_rsc=.. -> /room?id=..). O fetch do Next (mode cors) e
	# arquivos .txt comuns (robots.txt, sem _rsc) nao casam.
	@rscIndex {
		path_regexp rscindex ^(.*/)index\.txt$
		header Sec-Fetch-Mode navigate
		query _rsc=*
	}
	redir @rscIndex {re.rscindex.1}?{query} 302
	@rscPage {
		path_regexp rscpage ^(/.+)\.txt$
		header Sec-Fetch-Mode navigate
		query _rsc=*
	}
	redir @rscPage {re.rscpage.1}?{query} 302

	# Todo o resto -> frontend estatico.
	handle {
		root * /srv

		# CSP com os sha256 dos scripts inline do export (gerada no build por
		# apps/web/scripts/csp.mjs): script-src sem 'unsafe-inline'.
		import csp.caddy
		header {
			X-Content-Type-Options nosniff
			Referrer-Policy no-referrer
			X-Frame-Options DENY
			Permissions-Policy "microphone=(self), display-capture=(self), speaker-selection=(self), camera=(), geolocation=(), payment=(), usb=()"
			-Server
		}

		# Assets com hash no nome: cache longo e imutavel. HTML sempre revalidado.
		@hashed path /_next/static/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@html not path /_next/static/*
		header @html Cache-Control "no-cache"

		# PWA: tipo correto do manifesto e service worker sempre revalidado.
		@manifest path /manifest.webmanifest
		header @manifest Content-Type "application/manifest+json"
		@sw path /sw.js
		header @sw Cache-Control "no-cache"

		try_files {path} {path}.html {path}/ /index.html
		file_server
	}
}
