# ---------------------------------------------------------------
# Scale — configuracao de DESENVOLVIMENTO NO HOST (npm run dev)
#
# Este arquivo e lido por:
#   - apps/server: `tsx watch --env-file-if-exists=../../.env`
#   - apps/web:    apps/web/next.config.js (process.loadEnvFile, SO em `next dev`;
#                  o build de producao e estatico e nao le env server-side)
#   - docker:   docker-compose.yml (env_file), que SOBREPOE PORT,
#               DATABASE_URL, NODE_ENV e TRUST_PROXY para a rede do container.
#
# Variaveis ja presentes no ambiente tem precedencia sobre este arquivo
# (semantica do --env-file), entao os overrides do Docker sempre vencem.
# ---------------------------------------------------------------

# Segredo do JWT. Minimo 8 caracteres em dev/teste.
# OBRIGATORIO >= 32 caracteres com NODE_ENV=production (o Docker define
# production): o valor abaixo e so para dev e faz o backend ABORTAR o start em
# producao. Trocar o valor derruba as sessoes abertas. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-in-production

# Segredo HMAC do cookie do convidado (`scale_guest`, HttpOnly, SameSite=Strict,
# Secure em producao, 180 dias). O cookie carrega o guestId (UUID v4) emitido
# pelo servidor, que define a AUTORIA de mensagens/arquivos de convidado (o nome
# exibido nao concede permissao). Minimo 32 caracteres.
# OBRIGATORIO com NODE_ENV=production (o Docker define production): sem ele o
# backend ABORTA o start. Em dev/teste, vazio = derivado do JWT_SECRET.
# Trocar o valor invalida os cookies existentes: cada convidado vira um guestId
# novo e perde a autoria das mensagens antigas. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GUEST_COOKIE_SECRET=

# Dev no host: Prisma resolve o caminho relativo a apps/server/prisma/.
# Docker: o docker-compose.yml sobrescreve para file:/app/data/data.db.
DATABASE_URL=file:./data.db

# Porta em que o backend escuta localmente.
# 4100 evita colisao com um PostgreSQL local que costuma ocupar a 4000.
PORT=4100

# Porta do backend no HOST. Em `npm run dev` o next.config.js aponta o rewrite
# /api e o WebSocket de dev (NEXT_PUBLIC_DEV_WS_URL) para ela. No Docker ela e
# publicada so no loopback (diagnostico); o browser usa o proxy.
# No Docker o container segue escutando 4000 internamente.
BACKEND_PORT=4100

# Porta do HOST do proxy (Caddy: frontend estatico + /api + /socket.io).
# E a entrada do app no Docker. Em acesso local HTTP, a origem
# http://localhost:<PROXY_PORT> precisa estar em ALLOWED_ORIGINS abaixo.
# Em acesso pelo tunel (HTTPS) o app e same-origin e o CORS nao entra em jogo.
PROXY_PORT=8080

# Origens permitidas (CSV): fonte unica do CORS HTTP (plugins/cors.ts) e do
# CORS do Socket.io (socket/handler.ts).
#   localhost:3000 = frontend em dev (next dev; o WebSocket vai direto ao backend).
#   localhost:8080 = proxy interno (Caddy) em acesso local HTTP.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# ---------------------------------------------------------------
# TURN (relay de audio/tela). Sem ele, quem esta atras de CGNAT, 4G ou rede de
# empresa entra na sala mas ninguem se ouve. Suba o coturn com o profile `turn`
# (docker compose --profile turn --profile tunnel up -d) e abra no roteador/
# firewall: 3478 UDP+TCP e 49160-49200 UDP. O audio NAO passa pelo tunel.
#
# TURN_URL: CSV de URLs, com o IP/dominio PUBLICO do host.
# TURN_SECRET: credencial temporaria (recomendado); o mesmo valor vai para o
#   coturn. Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# TURN_EXTERNAL_IP: IP publico do host (o coturn anuncia este endereco).
# TURN_TTL_SECONDS: validade da credencial (padrao 86400 = 24 h).
# TURN_USERNAME/TURN_CREDENTIAL: so para provedor externo com senha fixa
#   (usados quando TURN_SECRET esta vazio).
# ---------------------------------------------------------------
ENABLE_TURN=false
TURN_URL=
TURN_SECRET=
TURN_EXTERNAL_IP=
TURN_TTL_SECONDS=
TURN_USERNAME=
TURN_CREDENTIAL=
NODE_ENV=development

# ---------------------------------------------------------------
# TRUST_PROXY — quais proxies podem definir o IP do cliente
#
# 'false' (default, fail-closed) = nenhum: o IP dos rate limits e o da conexao
# TCP (o socket), entao X-Forwarded-For e cf-connecting-ip forjados NAO criam
# balde novo. E o valor correto em dev no host (rewrite /api do `next dev` na
# mesma maquina; loopback ja e isento dos baldes por IP fora de producao).
#
# No Docker (container atras do proxy interno), o docker-compose.yml define
# TRUST_PROXY=172.28.0.4/32,172.28.0.5/32 — APENAS os hops REAIS, cada um com
# IP fixo (ipv4_address) na rede `scale`: `proxy` (Caddy, unico hop HTTP que
# encaminha /api e /socket.io ao backend) e `cloudflared` (hop do tunel). Nao
# ha mais container de frontend: ele e estatico, servido pelo proprio Caddy. Confiar so neles faz o Fastify usar o IP real do cliente e descartar
# o resto da cadeia.
#
# NUNCA use 'true' nem a subnet inteira (ex.: 172.28.0.0/16): o gateway
# 172.28.0.1 esta dentro do CIDR e e justamente o peer de quem alcanca uma porta
# publicada. Com ele confiavel, qualquer cliente forja X-Forwarded-For e fura
# TODOS os baldes por IP. O AGENTS.md ("Rede e exposicao") fixa esse modelo.
#
# Se rodar o backend fora do container mas atras de um proxy local, use o CIDR
# do proxy, ex.:
#   TRUST_PROXY=loopback            # proxy na mesma maquina (127.0.0.1/8,::1/128)
#   TRUST_PROXY=127.0.0.1/8         # equivalente explicito
# ---------------------------------------------------------------
TRUST_PROXY=false

# ---------------------------------------------------------------
# Administradores do sistema
#
# ADMIN_EMAILS: CSV de emails (logados por cookie) com poderes de admin: ler
# /api/metrics e o painel /metrics e APAGAR QUALQUER SALA. Comparacao sem
# diferenca de maiusculas/espacos. Vazio = ninguem.
ADMIN_EMAILS=
# METRICS_ADMIN_EMAILS: nome LEGADO de ADMIN_EMAILS, ainda aceito. Os dois sao
# unidos (quem esta em qualquer um e admin). Prefira ADMIN_EMAILS.
METRICS_ADMIN_EMAILS=

# ---------------------------------------------------------------
# Login com GitHub (opcional). Sem os tres valores o botao some.
# Crie um OAuth App em https://github.com/settings/developers
#   Homepage URL:               <PUBLIC_URL>
#   Authorization callback URL: <PUBLIC_URL>/api/auth/github/callback
# PUBLIC_URL = origem publica do app, sem barra final.
# O client secret e SEGREDO: so no .env, nunca no Git.
# ---------------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
PUBLIC_URL=

# ---------------------------------------------------------------
# Login com Google (opcional). Sem GOOGLE_CLIENT_ID/SECRET + PUBLIC_URL o
# botao some. Google Cloud Console > APIs e servicos > Credenciais >
# ID do cliente OAuth (Aplicativo da Web):
#   Origem JavaScript autorizada: <PUBLIC_URL>
#   URI de redirecionamento:      <PUBLIC_URL>/api/auth/google/callback
# O client secret e SEGREDO: so no .env, nunca no Git.
# ---------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
