# ---------------------------------------------------------------
# Scale — configuracao de DESENVOLVIMENTO NO HOST (npm run dev)
#
# Este arquivo e lido por:
#   - backend:  `tsx watch --env-file-if-exists=../.env`
#   - frontend: frontend/next.config.js (process.loadEnvFile)
#   - docker:   docker-compose.yml (env_file), que SOBREPOE PORT e
#               DATABASE_URL para a rede interna do container.
#
# Variaveis ja presentes no ambiente tem precedencia sobre este arquivo
# (semantica do --env-file), entao os overrides do Docker sempre vencem.
# ---------------------------------------------------------------

# Segredo do JWT (minimo 8 caracteres). Troque em producao.
JWT_SECRET=change-me-in-production

# Dev no host: Prisma resolve o caminho relativo a backend/prisma/.
# Docker: o docker-compose.yml sobrescreve para file:/app/data/data.db.
DATABASE_URL=file:./data.db

# Porta em que o backend escuta localmente.
# 4100 evita colisao com um PostgreSQL local que costuma ocupar a 4000.
PORT=4100

# Porta exposta no host e usada pelo browser (tambem alimenta o
# NEXT_PUBLIC_BACKEND_PORT, lido pelo WebSocket no cliente).
# No Docker o container segue escutando 4000 internamente.
BACKEND_PORT=4100

ALLOWED_ORIGINS=http://localhost:3000,http://100.119.215.105:3000,http://DESKTOP-SIE986U:3000,http://desktop-sie986u:3000,https://desktop-sie986u.taile13b10.ts.net:3443
NEXT_PUBLIC_BACKEND_URL=http://localhost:4100
ENABLE_TURN=false
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
# Scale — TAILSCALE_IP (IP Tailscale do servidor para rede mesh)
TAILSCALE_IP=
TAILSCALE_HOST=
ENABLE_HTTPS=false
HTTPS_PORT=3443
NODE_ENV=development
MCP_TOKEN=change-me-in-production
