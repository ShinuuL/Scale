# ---------------------------------------------------------------
# Scale — configuracao de DESENVOLVIMENTO NO HOST (npm run dev)
#
# Este arquivo e lido por:
#   - apps/server: `tsx watch --env-file-if-exists=../../.env`
#   - apps/web:    apps/web/next.config.js (process.loadEnvFile, SO em `next dev`;
#                  o build de producao e estatico e nao le env server-side)
#   - docker:   docker-compose.yml (env_file), que SOBREPOE PORT,
#               DATABASE_URL, NODE_ENV e TRUST_PROXY para a rede do container.
#
# Variaveis ja presentes no ambiente tem precedencia sobre este arquivo
# (semantica do --env-file), entao os overrides do Docker sempre vencem.
# ---------------------------------------------------------------

# Segredo do JWT (minimo 8 caracteres). Troque em producao.
JWT_SECRET=change-me-in-production

# Dev no host: Prisma resolve o caminho relativo a apps/server/prisma/.
# Docker: o docker-compose.yml sobrescreve para file:/app/data/data.db.
DATABASE_URL=file:./data.db

# Porta em que o backend escuta localmente.
# 4100 evita colisao com um PostgreSQL local que costuma ocupar a 4000.
PORT=4100

# Porta do backend no HOST. Em `npm run dev` o next.config.js aponta o rewrite
# /api e o WebSocket de dev (NEXT_PUBLIC_DEV_WS_URL) para ela. No Docker ela e
# publicada so no loopback (diagnostico); o browser usa o proxy.
# No Docker o container segue escutando 4000 internamente.
BACKEND_PORT=4100

# Porta do HOST do proxy (Caddy: frontend estatico + /api + /socket.io).
# E a entrada do app no Docker. Em acesso local HTTP, a origem
# http://localhost:<PROXY_PORT> precisa estar em ALLOWED_ORIGINS abaixo.
# Em acesso pelo tunel (HTTPS) o app e same-origin e o CORS nao entra em jogo.
PROXY_PORT=8080

# Origens permitidas (CSV): fonte unica do CORS HTTP (plugins/cors.ts) e do
# CORS do Socket.io (socket/handler.ts).
#   localhost:3000 = frontend em dev (next dev; o WebSocket vai direto ao backend).
#   localhost:8080 = proxy interno (Caddy) em acesso local HTTP.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

ENABLE_TURN=false
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
NODE_ENV=development

# ---------------------------------------------------------------
# TRUST_PROXY — quais proxies podem definir o IP do cliente
#
# 'false' (default, fail-closed) = nenhum: o IP dos rate limits e o da conexao
# TCP (o socket), entao X-Forwarded-For e cf-connecting-ip forjados NAO criam
# balde novo. E o valor correto em dev no host (rewrite /api do `next dev` na
# mesma maquina; loopback ja e isento dos baldes por IP fora de producao).
#
# No Docker (container atras do proxy interno), o docker-compose.yml define
# TRUST_PROXY=172.28.0.4/32,172.28.0.5/32 — APENAS os hops REAIS, cada um com
# IP fixo (ipv4_address) na rede `scale`: `proxy` (Caddy, unico hop HTTP que
# encaminha /api e /socket.io ao backend) e `cloudflared` (hop do tunel). Nao
# ha mais container de frontend: ele e estatico, servido pelo proprio Caddy. Confiar so neles faz o Fastify usar o IP real do cliente e descartar
# o resto da cadeia.
#
# NUNCA use 'true' nem a subnet inteira (ex.: 172.28.0.0/16): o gateway
# 172.28.0.1 esta dentro do CIDR e e justamente o peer de quem alcanca uma porta
# publicada. Com ele confiavel, qualquer cliente forja X-Forwarded-For e fura
# TODOS os baldes por IP. O AGENTS.md ("Rede e exposicao") fixa esse modelo.
#
# Se rodar o backend fora do container mas atras de um proxy local, use o CIDR
# do proxy, ex.:
#   TRUST_PROXY=loopback            # proxy na mesma maquina (127.0.0.1/8,::1/128)
#   TRUST_PROXY=127.0.0.1/8         # equivalente explicito
# ---------------------------------------------------------------
TRUST_PROXY=false

# Token do MCP server (Bearer de quem chama /mcp/*). OBRIGATORIO e com no
# minimo 32 caracteres: sem ele o MCP aborta o start. Comparado em tempo
# constante. O MCP so e publicado em 127.0.0.1:4001. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MCP_TOKEN=

# ---------------------------------------------------------------
# /api/metrics — acesso restrito a administradores
#
# METRICS_ADMIN_EMAILS: CSV de emails de usuarios que podem ler /api/metrics
# (logados por cookie). Vazio = ninguem; usuario fora da lista recebe 403.
METRICS_ADMIN_EMAILS=

# METRICS_SERVICE_TOKEN: token de servico do MCP para /api/metrics (o MCP nao
# tem sessao de usuario). Minimo 32 caracteres (menor = desligado). O backend
# compara em tempo constante (timingSafeEqual). Use o MESMO valor no backend e
# no MCP (o docker-compose repassa esta env ao servico `mcp`). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Vazio = /mcp/metrics responde 503 com a instrucao.
METRICS_SERVICE_TOKEN=
